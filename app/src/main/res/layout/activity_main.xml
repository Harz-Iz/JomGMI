<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="60dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Top Header Banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_gradient_header"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="28dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/ic_gmi_logo" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="JomGMI"
                            android:textColor="@color/white"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="German-Malaysian Institute • Course Finder"
                            android:textColor="@color/accent"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:alpha="0.9"
                    android:lineSpacingExtra="2dp"
                    android:text="Enter your SPM / O-Level / SVM grades below. Matching GMI programmes will appear automatically."
                    android:textColor="@color/white"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- Grade Input Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGradeInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="-16dp"
                android:layout_marginEnd="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your Academic Qualifications"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Qualification Spinner Row -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/qualification_label"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spQualification"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_search_input"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp" />

                    <!-- Number of Credits Input Row -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/credits_label"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:boxCornerRadiusBottomEnd="10dp"
                            app:boxCornerRadiusBottomStart="10dp"
                            app:boxCornerRadiusTopEnd="10dp"
                            app:boxCornerRadiusTopStart="10dp"
                            app:boxStrokeColor="@color/primary">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etCredits"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Credits / Passes (e.g. 5)"
                                android:inputType="number"
                                android:maxLength="2"
                                android:text="3"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Quick Credit Presets -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCreditMinus"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="8dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            android:text="-"
                            android:textColor="@color/primary"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            app:backgroundTint="@color/primary_container"
                            app:cornerRadius="10dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCreditPlus"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="6dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            android:text="+"
                            android:textColor="@color/primary"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            app:backgroundTint="@color/primary_container"
                            app:cornerRadius="10dp" />

                    </LinearLayout>

                    <!-- Core Subject Passes Checkboxes -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Core Subject Grades"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical">

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cbMaths"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/cb_maths"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cbScience"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="false"
                            android:text="@string/cb_science"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cbBm"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/cb_bm"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cbEnglish"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/cb_english"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <!-- Pre-University STEM Subjects (Dynamic Visibility for SPM & 5+ credits) -->
                    <LinearLayout
                        android:id="@+id/layoutStemSubjects"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_badge_rounded"
                        android:backgroundTint="#F3E8FF"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:visibility="visible">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="STEM Subjects (Required for GAPP &amp; GUFP)"
                            android:textColor="#6D28D9"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cbAddMaths"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/cb_add_maths"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cbPhysics"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/cb_physics"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cbChemistry"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/cb_chemistry"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <!-- Buttons Row: Find My Courses & Clear Grades -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnClearGrades"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="0.43"
                            android:layout_marginEnd="8dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:gravity="center"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:paddingHorizontal="12dp"
                            android:text="@string/clear_grades_btn"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            app:cornerRadius="12dp"
                            app:icon="@drawable/ic_clear"
                            app:iconGravity="textStart"
                            app:iconPadding="6dp"
                            app:iconSize="16dp"
                            app:iconTint="@color/text_secondary"
                            app:strokeColor="@color/card_stroke" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFindCourses"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="0.57"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:gravity="center"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:paddingHorizontal="12dp"
                            android:text="@string/find_courses_btn"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/primary"
                            app:cornerRadius="12dp"
                            app:icon="@drawable/ic_search"
                            app:iconGravity="textStart"
                            app:iconPadding="6dp"
                            app:iconSize="16dp"
                            app:iconTint="@color/white" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Section Header: Programmes You May Qualify For -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/title_programmes_matched"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMatchedCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_rounded"
                    android:backgroundTint="@color/accent_light"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:text="0 Programmes"
                    android:textColor="@color/on_accent_container"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- RecyclerView for Matched Courses -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvEligibleCourses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                tools:itemCount="3"
                tools:listitem="@layout/item_course_card" />

            <!-- Empty State Container -->
            <LinearLayout
                android:id="@+id/layoutEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_search_input"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="28dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:alpha="0.6"
                    android:contentDescription="@string/empty_matched_title"
                    android:src="@drawable/ic_school"
                    app:tint="@color/text_hint" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/empty_matched_title"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/empty_matched_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExploreAll"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/explore_all_btn"
                    android:textColor="@color/primary"
                    app:backgroundTint="@color/primary_container"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_explore"
                    app:iconTint="@color/primary" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="bottom"
        android:background="@color/white"
        app:elevation="8dp"
        app:itemIconTint="@color/primary"
        app:itemRippleColor="@color/accent_light"
        app:itemTextColor="@color/primary"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>