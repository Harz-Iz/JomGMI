<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.JomGMI">

        <!-- Splash Activity as Launcher -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.JomGMI">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main Home Screen -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />

        <!-- Explore Programmes Screen -->
        <activity
            android:name=".CoursesActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />

        <!-- Course Detail Screen -->
        <activity
            android:name=".CourseDetailActivity"
            android:exported="false" />

        <!-- Standalone Eligibility Checker -->
        <activity
            android:name=".EligibilityActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />

        <!-- About & Contact GMI Screen -->
        <activity
            android:name=".AboutContactActivity"
            android:exported="false" />

    </application>

</manifest>